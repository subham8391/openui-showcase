{
  "name": "@openuidev/dashboard-kits",
  "version": "0.0.0",
  "private": true,
  "description": "Dashboard kits for OpenUI: domain component libraries, data-tool contracts, prompts, and sample data a model composes into e-commerce and product analytics dashboards",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ecommerce": {
      "import": {
        "types": "./dist/ecommerce.d.mts",
        "default": "./dist/ecommerce.mjs"
      },
      "require": {
        "types": "./dist/ecommerce.d.cts",
        "default": "./dist/ecommerce.cjs"
      }
    },
    "./analytics": {
      "import": {
        "types": "./dist/analytics.d.mts",
        "default": "./dist/analytics.mjs"
      },
      "require": {
        "types": "./dist/analytics.d.cts",
        "default": "./dist/analytics.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsdown && pnpm run build:scss",
    "build:scss": "sass src/styles/index.scss dist/styles.css --style compressed --no-source-map",
    "watch": "concurrently \"tsdown --watch\" \"pnpm run build:scss --watch\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format:fix": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "check:publint": "publint",
    "check:attw": "attw --pack . --ignore-rules no-resolution",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test"
  },
  "keywords": [
    "openui",
    "generative-ui",
    "dashboard",
    "analytics",
    "e-commerce",
    "product-analytics",
    "charts",
    "openui-lang"
  ],
  "homepage": "https://openui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/thesysdev/openui.git",
    "directory": "packages/dashboard-kits"
  },
  "bugs": {
    "url": "https://github.com/thesysdev/openui/issues"
  },
  "author": "engineering@thesys.dev",
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0"
  },
  "peerDependencies": {
    "@openuidev/lang-core": ">=0.3.0 <2.0.0",
    "@openuidev/react-lang": ">=0.3.0 <2.0.0",
    "@openuidev/react-ui": ">=0.17.0 <0.19.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@openuidev/lang-core": "0.3.2",
    "@openuidev/react-headless": "0.17.1",
    "@openuidev/react-lang": "0.3.2",
    "@openuidev/react-ui": "0.17.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.18",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rimraf": "^5.0.7",
    "sass": "^1.83.4",
    "tsdown": "^0.21.7",
    "vitest": "^4.0.18",
    "zod": "^4.3.6",
    "zustand": "^4.5.7"
  }
}
