{
  "name": "openui-showcase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A website of OpenUI examples, starting with dashboard kits for e-commerce and product analytics",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate": "openui generate examples/dashboard-kits/kits/specs/ecommerce.ts --spec --out examples/dashboard-kits/kits/generated/ecommerce.spec.json && openui generate examples/dashboard-kits/kits/specs/analytics.ts --spec --out examples/dashboard-kits/kits/generated/analytics.spec.json",
    "predev": "pnpm run generate",
    "dev": "next dev --hostname 127.0.0.1 --port 3940",
    "prebuild": "pnpm run generate",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "pnpm run generate",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run generate",
    "test": "vitest run",
    "precheck": "pnpm run generate",
    "check": "tsx examples/dashboard-kits/scripts/check-kits.ts && tsx examples/dashboard-kits/scripts/smoke-kits.tsx",
    "preeval": "pnpm run generate",
    "eval": "tsx --conditions=react-server examples/dashboard-kits/scripts/eval/run.ts",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run check && pnpm run build"
  },
  "dependencies": {
    "@openuidev/lang-core": "0.3.2",
    "@openuidev/react-headless": "0.17.1",
    "@openuidev/react-lang": "0.3.2",
    "@openuidev/react-ui": "0.17.1",
    "@openuidev/thesys": "0.14.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "next": "16.2.6",
    "openai": "^6.49.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "^4.3.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@openuidev/cli": "0.5.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.15.32",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
    "sass": "^1.83.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "@openuidev/thesys>@openuidev/react-ui": "0.17.1",
      "@openuidev/thesys>@openuidev/react-headless": "0.17.1",
      "postcss@<8.5.10": ">=8.5.10",
      "uuid@<11.1.1": "^11.1.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@openuidev/thesys>@openuidev/react-ui": "0.17",
        "@openuidev/thesys>@openuidev/react-headless": "0.17"
      }
    },
    "onlyBuiltDependencies": [
      "@openuidev/lang-core",
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
