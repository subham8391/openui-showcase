{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "kits:build": "pnpm --filter @openuidev/dashboard-kits run build",
    "generate": "openui generate src/kits/ecommerce-library.ts --spec --out src/generated/ecommerce.spec.json && openui generate src/kits/analytics-library.ts --spec --out src/generated/analytics.spec.json",
    "prepare:kits": "pnpm run kits:build && pnpm run generate",
    "predev": "pnpm run prepare:kits",
    "dev": "next dev --hostname 127.0.0.1 --port 3940",
    "prebuild": "pnpm run prepare:kits",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "precheck": "pnpm run prepare:kits",
    "check": "tsx scripts/check-kits.ts && pnpm run smoke",
    "smoke": "tsx scripts/smoke-kits.tsx",
    "pretypecheck": "pnpm run prepare:kits",
    "typecheck": "tsc --noEmit",
    "preeval": "pnpm run prepare:kits",
    "eval": "tsx scripts/eval/run.ts"
  },
  "dependencies": {
    "@openuidev/dashboard-kits": "workspace:*",
    "@openuidev/lang-core": "0.3.2",
    "@openuidev/react-headless": "0.17.1",
    "@openuidev/react-lang": "0.3.2",
    "@openuidev/react-ui": "0.17.1",
    "@openuidev/thesys": "0.14.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "next": "16.2.6",
    "openai": "^6.49.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@openuidev/cli": "0.5.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.15.32",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
